# copy to backend/.env and export, or set in your shell
COGNIGRAPH_STORE=memory            # memory | postgres
COGNIGRAPH_EMBEDDER=hashing        # hashing (instant, lexical) | sbert (real local model)
COGNIGRAPH_RERANKER=lexical        # none | lexical | cross-encoder
DATABASE_URL=postgresql://cognigraph:cognigraph@localhost:5432/cognigraph
